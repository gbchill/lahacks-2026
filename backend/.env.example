# Server
PORT=8000
ENVIRONMENT=development

# Google AI (Gemini Vision + Gemma)
GEMINI_API_KEY=
GEMMA_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=orision

# Supabase (server-side keys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (server-side, for transforms requiring auth)
CLOUDINARY_CLOUD_NAME=dyyjuq6gr
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fetch.ai uAgents — seeds are deterministic, never change after first run
PARSER_AGENT_SEED=orision-parser-agent-v1-lahacks2026
CONTEXT_AGENT_SEED=orision-context-agent-v1-lahacks2026
DRAFTER_AGENT_SEED=orision-drafter-agent-v1-lahacks2026
TRANSLATOR_AGENT_SEED=orision-translator-agent-v1-lahacks2026
ORCHESTRATOR_AGENT_SEED=orision-orchestrator-agent-v1-lahacks2026

# Derived addresses (computed from seeds, used for routing)
PARSER_AGENT_ADDRESS=
CONTEXT_AGENT_ADDRESS=
DRAFTER_AGENT_ADDRESS=
TRANSLATOR_AGENT_ADDRESS=
ORCHESTRATOR_AGENT_ADDRESS=

# Bureau runs agents on this port (separate from FastAPI)
BUREAU_PORT=8001

# Agentverse registration — see AGENTVERSE_REGISTRATION.md
FETCHAI_AGENTVERSE_API_KEY=

# Frontend origin (for CORS sanity checks)
FRONTEND_URL=http://localhost:5173
